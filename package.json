  "author": "Nazarii1202",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @testing-task/web",
    "dev:backend": "npm run start:dev --workspace @testing-task/backend",
    "build:web": "npm run build --workspace @testing-task/web",
    "build:backend": "npm run build --workspace @testing-task/backend",
    "build": "npm run build:backend && npm run build:web"
  }
}
