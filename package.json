{
  "name": "@testing-task/workspace",
  "version": "0.0.1",
  "description": "Acme Data Room MVP monorepo",
  "homepage": "https://github.com/Nazarii1202/testing-tesk#readme",
  "bugs": {
    "url": "https://github.com/Nazarii1202/testing-tesk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nazarii1202/testing-tesk.git"
